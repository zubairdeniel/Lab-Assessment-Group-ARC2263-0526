{
  "functions": {
    "admin/*.php": { "runtime": "vercel-php@0.9.0" },
    "client/*.php": { "runtime": "vercel-php@0.9.0" }
  },
  "routes": [
    { "src": "/admin/(.*)", "dest": "/admin/$1" },
    { "src": "/client/(.*)", "dest": "/client/$1" },
    { "src": "/(.*)", "dest": "/client/$1" }
  ]
}